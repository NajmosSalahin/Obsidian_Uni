filters:
  and:
    - file.hasProperty("created")
    - type == "journal"
    - file.hasProperty("type")
    - file.inFolder("Github/Journal")
views:
  - type: table
    name: Table
    filters:
      and:
        - type == "journal"
        - file.hasProperty("created")
    order:
      - file.name
      - created
