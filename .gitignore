# Ignore everything at root level
/*

# But allow root-level files
!/.gitignore
!/README.md

# Allow the specific folders and their contents
!/SDS-Vault/
!/SDS-Vault/**
!/9-resources/
!/9-resources/**

# Ignore Extra Knowledge inside SDS Vault
/SDS-Vault/Extra Knowledge/
/SDS-Vault/Extra Knowledge/**
